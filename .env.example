# Copy to .env (never commit .env)
ANTHROPIC_API_KEY=
# Model id for the backend's Claude calls
ANTHROPIC_MODEL=claude-sonnet-5-5
# Faster model for the text-only first pass (latency-critical)
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
PORT=8787
# Where the phone reaches the backend (your laptop's LAN IP). Inlined into the miniapp build.
MENTRA_PUBLIC_BACKEND_URL=http://192.168.0.0:8787
