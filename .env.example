# Copy to .env (never commit .env)
ANTHROPIC_API_KEY=
# Model id for the backend's Claude calls
ANTHROPIC_MODEL=claude-sonnet-5-5
# Text-only passes (scam first pass, ask without a photo). Measured: Haiku ~1.2 s, Sonnet ~2.2 s with 3-4 s spikes,
# and no better judgement on our test lines. Set to claude-sonnet-5-5 to trade speed for depth.
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
# Router model. Keep on Haiku: it forces a tool call, which Sonnet does not support, and it must be fast.
ANTHROPIC_MODEL_ROUTER=claude-haiku-5-5
PORT=8787
# Where the phone reaches the backend (your laptop's LAN IP). Inlined into the miniapp build.
MENTRA_PUBLIC_BACKEND_URL=http://192.168.0.0:8787
