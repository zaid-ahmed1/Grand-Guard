<mxfile host="app.diagrams.net"><diagram name="Ally architecture" id="ally-arch"><mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="680" background="#f5f9f8" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Ally: how it works" style="text;html=0;whiteSpace=wrap;fontFamily=Nunito Sans;fontSize=30;fontStyle=1;fontColor=#244b45;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="700" height="40" as="geometry"/></mxCell><mxCell id="n3" value="Independence, with peace of mind." style="text;html=0;whiteSpace=wrap;fontFamily=Nunito Sans;fontSize=14;fontStyle=0;fontColor=#5d716b;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="700" height="24" as="geometry"/></mxCell><mxCell id="n4" value="Wearer&#10;Mentra Live glasses&#10;microphone · camera · speaker" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#bde8df;strokeColor=#244b45;strokeWidth=2;fontFamily=Nunito Sans;fontSize=14;fontStyle=1;fontColor=#1c2b27;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="220" height="130" as="geometry"/></mxCell><mxCell id="n5" value="Phone&#10;Ally miniapp&#10;listens, decides, runs the&#10;skill, whispers the answer" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#e4f2ef;strokeColor=#244b45;strokeWidth=2;fontFamily=Nunito Sans;fontSize=14;fontStyle=1;fontColor=#1c2b27;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="400" y="150" width="220" height="130" as="geometry"/></mxCell><mxCell id="n6" value="Server&#10;calls Claude, then plain code&#10;decides: allergens, dates,&#10;schedule, alerts" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#fdf1da;strokeColor=#f2b655;strokeWidth=2;fontFamily=Nunito Sans;fontSize=14;fontStyle=1;fontColor=#1c2b27;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="760" y="150" width="220" height="130" as="geometry"/></mxCell><mxCell id="n7" value="Anthropic Claude&#10;reads the label and the words.&#10;It never makes the safety call." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#4e7e6d;strokeWidth=2;fontFamily=Nunito Sans;fontSize=14;fontStyle=1;fontColor=#1c2b27;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1120" y="150" width="220" height="130" as="geometry"/></mxCell><mxCell id="n8" value="Mentra cloud&#10;holds each photo briefly" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#4e7e6d;strokeWidth=2;fontFamily=Nunito Sans;fontSize=14;fontStyle=1;fontColor=#1c2b27;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="400" y="400" width="220" height="90" as="geometry"/></mxCell><mxCell id="n9" value="Caregiver app&#10;(installable on Android)&#10;alerts, schedule,&#10;foods to avoid" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#bde8df;strokeColor=#244b45;strokeWidth=2;fontFamily=Nunito Sans;fontSize=14;fontStyle=1;fontColor=#1c2b27;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="804" y="400" width="220" height="110" as="geometry"/></mxCell><mxCell id="e10" value="audio + photos&#10;⇄ whispers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeWidth=3;strokeColor=#244b45;endArrow=block;endFill=1;endSize=8;startSize=8;startArrow=block;startFill=1;fontFamily=Nunito Sans;fontSize=12;fontStyle=1;fontColor=#244b45;labelBackgroundColor=#f5f9f8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="text + photo link&#10;⇄ verdict&#10;(via Cloudflare tunnel)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=